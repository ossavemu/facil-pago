---
type State = 'ok' | 'low' | 'neg';
const stock: { name: string; qty: number; unit: string; state: State }[] = [
  { name: 'Coca-Cola 400 ml', qty: 46, unit: 'und', state: 'ok' },
  { name: 'Arroz Diana 500 g', qty: -2, unit: 'und', state: 'neg' },
  { name: 'Leche Alquería 1,1 L', qty: 3, unit: 'und', state: 'low' },
  { name: 'Huevo AA', qty: 84, unit: 'und', state: 'ok' },
  { name: 'Queso campesino', qty: 4.5, unit: 'lb', state: 'ok' },
];
const label: Record<State, string> = { ok: 'Bien', low: 'Bajo mínimo', neg: 'Stock negativo' };
const features = [
  { title: 'Sin contraseñas', body: 'Escribe «portal» a tu línea y te llega un enlace de acceso que solo sirve una vez.' },
  { title: 'Hecho para el celular', body: 'Inventario, ventas del día y el detalle de cada venta con su soporte.' },
  { title: 'Alertas que importan', body: 'Productos bajo mínimo, stock negativo y fotos que la IA no supo reconocer.' },
  { title: 'Carga inicial desde Excel', body: 'Sube tu catálogo de una vez y completa las fotos por WhatsApp.' },
];
---

<section class="section portal" id="portal">
  <div class="wrap grid">
    <div class="mock" aria-label="Ejemplo del portal: inventario de la tienda" role="img">
      <div class="mock-head">
        <div>
          <p class="mock-title">Inventario</p>
          <p class="mock-sub">Tienda Doña Rosa · hoy 6:15 p. m.</p>
        </div>
        <span class="inbox"><b class="num">4</b> por revisar</span>
      </div>
      <div class="kpis">
        <div><span class="num">$1.284.300</span><small>Ventas de hoy</small></div>
        <div><span class="num">71</span><small>Ventas</small></div>
        <div><span class="num">3</span><small>Sin soporte</small></div>
      </div>
      <ul class="stock">
        {
          stock.map((s) => (
            <li class={s.state}>
              <span class="name">{s.name}</span>
              <span class="qty num">
                {s.qty.toLocaleString('es-CO')} {s.unit}
              </span>
              <span class="pill">{label[s.state]}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="copy">
      <div class="section-head">
        <p class="eyebrow">Portal web</p>
        <h2>Las cuentas claras, sin abrir un computador.</h2>
        <p class="lede">
          El inventario nunca se edita a mano: cada número sale del libro de entradas, ventas y ajustes. Si algo no cuadra,
          sabes exactamente por qué.
        </p>
      </div>
      <dl class="features">
        {
          features.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .portal {
    background: var(--paper-raised);
    border-block: 1px solid var(--line);
  }
  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .copy {
    min-width: 0;
  }
  .features {
    display: grid;
    gap: 1.5rem;
    margin: 0;
  }
  @media (min-width: 40rem) {
    .features {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 2rem;
    }
  }
  dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }
  dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .mock {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -35px rgb(16 38 63 / 0.35);
    min-width: 0;
  }
  .mock-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
  }
  .mock-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .mock-sub {
    font-size: var(--step--1);
    color: var(--ink-mute);
  }
  .inbox {
    flex: none;
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--tag);
    color: var(--tag-ink);
    font-weight: 600;
  }
  .kpis {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 0.5rem;
  }
  .kpis div {
    display: grid;
    padding: 0.7rem 0.8rem;
    border-radius: var(--radius);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    min-width: 0;
  }
  .kpis span {
    font-size: clamp(0.9rem, 0.8rem + 0.5vw, 1.1rem);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .kpis small {
    font-size: 0.72rem;
    color: var(--ink-mute);
  }
  .stock {
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: var(--radius);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .stock li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 0.75rem;
    align-items: center;
    padding: 0.75rem 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .stock li:first-child {
    border-top: 0;
  }
  .name {
    min-width: 0;
    font-weight: 500;
  }
  .qty {
    text-align: right;
  }
  .pill {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    color: var(--ok);
    background: color-mix(in oklab, var(--ok) 14%, transparent);
  }
  .low .pill {
    color: var(--warn);
    background: color-mix(in oklab, var(--warn) 14%, transparent);
  }
  .neg .pill {
    color: var(--bad);
    background: color-mix(in oklab, var(--bad) 14%, transparent);
  }
  .neg .qty {
    color: var(--bad);
  }
  @media (min-width: 30rem) {
    .stock li {
      grid-template-columns: 1fr auto 7.5rem;
    }
    .pill {
      grid-column: auto;
      justify-self: end;
    }
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4.5rem;
    }
  }
</style>
