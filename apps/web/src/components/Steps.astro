---
// El flujo real de la demo, en orden: registrar → entrar mercancía → vender → soporte → consultar.
const steps = [
  {
    title: 'Registra tus productos',
    body: 'Mándale una foto del producto, un audio o un texto. La IA arma la ficha y tú confirmas precio y costo.',
    example: 'Foto: paquete de arroz Diana 500 g',
  },
  {
    title: 'Entra la mercancía',
    body: 'Cuando llega el proveedor, fotografía la factura o dicta lo que entró. El stock sube solo.',
    example: '«Llegaron 24 Coca-Cola de 400 a 1.900 cada una»',
  },
  {
    title: 'Vende por la línea de ventas',
    body: 'Di lo que se llevó el cliente. Fácil Pago busca en tu catálogo, te muestra opciones numeradas y tú respondes 1, 2 o 3.',
    example: '«Una libra de arroz y dos huevos»',
  },
  {
    title: 'Guarda el soporte del pago',
    body: 'Reenvía el pantallazo de Nequi, Bre-B o el banco. Se lee el monto y la referencia, y se compara con el total.',
    example: 'Pantallazo de transferencia por $18.700',
  },
  {
    title: 'Consulta todo desde el celular',
    body: 'Pide un enlace por WhatsApp y entra al portal sin contraseña: inventario, ventas, soportes y alertas.',
    example: '«portal» → enlace de acceso de un solo uso',
  },
];
---

<section class="section steps" id="como-funciona">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Cómo funciona</p>
      <h2>Cinco cosas que ya haces, ahora por chat.</h2>
      <p class="lede">No hay que aprender un programa. Si sabes mandar un audio, ya sabes usar Fácil Pago.</p>
    </div>

    <ol class="list">
      {
        steps.map((s, i) => (
          <li>
            <span class="n num">{String(i + 1).padStart(2, '0')}</span>
            <div class="text">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
            <p class="example">{s.example}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.5rem 1rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .n {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink-mute);
    line-height: 1.3;
  }
  .text {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  .text p {
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .example {
    grid-column: 2;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding: 0.45rem 0.75rem;
    border-radius: 0.6rem 0.6rem 0.6rem 0.15rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }
  @media (min-width: 52rem) {
    li {
      grid-template-columns: 4.5rem 1fr 18rem;
      align-items: start;
      gap: 2rem;
    }
    .example {
      grid-column: 3;
      justify-self: stretch;
    }
  }
</style>
